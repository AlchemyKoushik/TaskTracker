# local | server. Desktop backend uses local; VPS API uses server.
APP_MODE=local
APP_TIMEZONE=Asia/Kolkata
APP_HOST=127.0.0.1
APP_PORT=8765
IDLE_THRESHOLD_SECONDS=60
ACTIVITY_POLL_SECONDS=2
HEARTBEAT_SECONDS=5
SYNC_INTERVAL_SECONDS=60

# Local mode defaults to %LOCALAPPDATA%/TaskTracker/tasktracker.sqlite3.
LOCAL_DATABASE_URL=

# VPS only. Use the SQLAlchemy URL format for the actual hosted SQL engine.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# MySQL:      mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
SYNC_API_URL=
SYNC_API_TOKEN=
REPORT_API_TOKEN=
PUBLIC_REPORT_SIGNING_KEY=
PUBLIC_DASHBOARD_URL=https://tracker.alchemy-research.com

# Optional CORS origins for the UI dev server, comma separated.
CORS_ORIGINS=app://tasktracker,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://tracker.alchemy-research.com

# n8n should call the server report API using REPORT_API_TOKEN.
