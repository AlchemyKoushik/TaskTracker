  "components": {
    "schemas": {
      "CategoryCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CategoryCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PublishReportRequest": {
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "previous_week",
              "previous_month"
            ],
            "title": "Period"
          }
        },
        "type": "object",
        "required": [
          "period"
        ],
        "title": "PublishReportRequest"
      },
      "SettingsPatch": {
        "properties": {
          "idle_threshold_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600.0,
                "minimum": 30.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Threshold Seconds"
          }
        },
        "type": "object",
        "title": "SettingsPatch"
      },
      "StartTaskRequest": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "StartTaskRequest"
      },
      "SyncPushRequest": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/SyncRecord"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "SyncPushRequest"
      },
      "SyncRecord": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "category",
              "task",
              "workday",
              "time_entry",
              "activity_segment"
            ],
            "title": "Type"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "type",
          "id",
          "data"
        ],
        "title": "SyncRecord"
      },
      "TaskCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "title": "Name"
          },
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category_id"
        ],
        "title": "TaskCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
